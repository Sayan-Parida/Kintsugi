<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>
    <groupId>dev.kintsugi</groupId>
    <artifactId>kintsugi</artifactId>
    <version>0.1.0-alpha</version>
    <packaging>pom</packaging>
    <name>Kintsugi</name>
    <licenses>
        <license>
            <name>BSD 2-Clause License</name>
            <url>https://opensource.org/license/bsd-2-clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>assurance-core</module>
        <module>shirudo-cli</module>
        <module>linux-jvm</module>
        <module>assurance-fixtures</module>
        <module>orchestrator</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals><goal>select-jdk-toolchain</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <version>[21,22)</version>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
